{
  "manifest_version": 3,
  "name": "4̅2̅9̅ — Anti-429 for ChatGPT",
  "short_name": "4̅2̅9̅",
  "version": "0.2.1",
  "description": "Not-429: светофор лимитов ChatGPT, общий для всех вкладок pacing и удержание запросов вместо ошибки 'Could not load this conversation', диспетчер вкладок (discard). Неофициальное.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "webRequest",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared.js",
        "guard.js",
        "recovery.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "4̅2̅9̅",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
